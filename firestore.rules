rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function getUserRole() {
      return request.auth.token.role;
    }
    
    function getUserStoreId() {
      return request.auth.token.storeId;
    }
    
    function isOwner() {
      return getUserRole() == 'owner';
    }
    
    function isManager() {
      return getUserRole() == 'manager';
    }
    
    function isEmployee() {
      return getUserRole() == 'employee';
    }
    
    function hasStoreAccess(storeId) {
      return isOwner() || getUserStoreId() == storeId;
    }
    
    // Users collection - only owners can read all users
    match /users/{userId} {
      allow read: if isAuthenticated() && (isOwner() || request.auth.uid == userId);
      allow write: if isOwner();
    }
    
    // Stores collection
    match /stores/{storeId} {
      allow read: if isAuthenticated() && hasStoreAccess(storeId);
      allow create, update: if isOwner();
      allow delete: if isOwner();
    }
    
    // Products collection - global read for all authenticated users
    match /products/{productId} {
      allow read: if isAuthenticated();
      allow write: if isOwner() || isManager();
    }
    
    // Inventory collection - store-specific
    match /inventory/{inventoryId} {
      allow read: if isAuthenticated() && hasStoreAccess(resource.data.storeId);
      allow write: if isAuthenticated() && (isOwner() || isManager()) && hasStoreAccess(request.resource.data.storeId);
    }
    
    // Stock Movements - store-specific, sorted by timestamp DESC
    match /stockMovements/{movementId} {
      allow read: if isAuthenticated() && hasStoreAccess(resource.data.storeId);
      allow create: if isAuthenticated() && hasStoreAccess(request.resource.data.storeId);
      allow update, delete: if isOwner() || isManager();
    }
    
    // Stock Transfers - read destination store, write source store
    match /stockTransfers/{transferId} {
      allow read: if isAuthenticated() && (
        hasStoreAccess(resource.data.sourceStoreId) ||
        hasStoreAccess(resource.data.destinationStoreId)
      );
      allow create: if isAuthenticated() && isManager();
      allow update: if isAuthenticated() && (isOwner() || isManager());
      allow delete: if isOwner();
    }
    
    // Sales collection - sorted by timestamp DESC
    match /sales/{saleId} {
      allow read: if isAuthenticated() && (
        isOwner() || 
        hasStoreAccess(resource.data.storeId)
      );
      allow create: if isAuthenticated() && hasStoreAccess(request.resource.data.storeId);
      allow update, delete: if isOwner() || isManager();
    }
    
    // Customers collection
    match /customers/{customerId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }
    
    // Loyalty Accounts - accessible by phone number
    match /loyaltyAccounts/{phone} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }
    
    // Loyalty Transactions - sorted by timestamp DESC
    match /loyaltyTransactions/{transactionId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isOwner() || isManager();
    }
    
    // Suppliers collection
    match /suppliers/{supplierId} {
      allow read: if isAuthenticated();
      allow write: if isOwner() || isManager();
    }
    
    // Damaged Products - sorted by reportedAt DESC
    match /damagedProducts/{damagedId} {
      allow read: if isAuthenticated();
      allow write: if isOwner() || isManager();
    }
    
    // Festivals - sorted by startDate ASC
    match /festivals/{festivalId} {
      allow read: if isAuthenticated();
      allow write: if isOwner();
    }
    
    // Festival Alerts - sorted by createdAt DESC
    match /festivalAlerts/{alertId} {
      allow read: if isAuthenticated();
      allow write: if isOwner();
    }
    
    // Notifications - sorted by createdAt DESC
    match /notifications/{notificationId} {
      allow read: if isAuthenticated() && (
        resource.data.targetUserId == request.auth.uid ||
        hasStoreAccess(resource.data.targetStoreId) ||
        isOwner()
      );
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && resource.data.targetUserId == request.auth.uid;
      allow delete: if isOwner();
    }
  }
}
