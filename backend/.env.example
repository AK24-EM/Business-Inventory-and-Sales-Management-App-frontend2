# ==============================================================================
# StoreIQ Backend Environment Variables (Template)
# Copy this file to .env and adjust values as required:
# cp .env.example .env
# ==============================================================================

PROJECT_NAME="StoreIQ Cloud API"
VERSION="1.0.0"

# Google Cloud Platform (GCP) Configuration
GCP_PROJECT_ID="store-inventory-sale-manage"
GCP_REGION="asia-south1"

# Database Configuration
# - Local SQLite (Default): sqlite:///./storeiq.db
# - PostgreSQL / Cloud SQL: postgresql+psycopg2://<user>:<password>@<host>:5432/<dbname>
DATABASE_URL="sqlite:///./storeiq.db"

# JWT Authentication & Security
SECRET_KEY="your-super-secret-jwt-key-here"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Cloud Storage Bucket
GCS_BUCKET_NAME="storeiq-media-bucket"