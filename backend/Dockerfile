# Use official slim Python runtime for minimal image footprint
FROM python:3.11-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PORT=8080

WORKDIR /app

# Install dependencies
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy application code
COPY . .

# Run database seed if DB is fresh
RUN python seed_data.py || true

# Expose Cloud Run default port
EXPOSE 8080

# Launch production Uvicorn server
CMD exec uvicorn app.main:app --host 0.0.0.0 --port ${PORT} --workers 2
